# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only, never exposed to the client — bypasses row-level security. Only used by the
# /api/cron/reminders job, which has no user session and needs to read every user's data to
# decide who to notify. Same Project Settings > API page as the two keys above.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the magic-link redirect URL. http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only — used for payslip parsing (spec §7). Never exposed to the client.
ANTHROPIC_API_KEY=

# Web push notifications (payday/bill-due reminders). Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is also read client-side (NEXT_PUBLIC_), the private key never is.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the /api/cron/reminders route checks for — set the same value here and in
# Vercel's Cron Jobs config (or just rely on Vercel's automatic authorization header in prod).
CRON_SECRET=
