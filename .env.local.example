# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the magic-link redirect URL. http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only — used for payslip parsing (spec §7). Never exposed to the client.
ANTHROPIC_API_KEY=
